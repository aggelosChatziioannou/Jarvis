.DS_Store
.env/
.venv/
__pycache__/
.pytest_cache/
tests/performance/reports/
.mamba_env/
.micromamba/
.claude/*
!.claude/launch.json
!.claude/skills/

# Release artifacts
release_output.log
node_modules/

# PyInstaller build artifacts
build/
dist/
*.spec.backup
qt.conf

# Auto-generated version file (created at build time)
src/jarvis/_version.py

# Test artifacts (pytest MagicMock leaves a dir named MagicMock when an
# attribute access ends up being used as a path)
MagicMock/

# graphify skill outputs (analysis artefacts, can be regenerated)
graphify-out/

# Temporary developer test scripts + outputs (not part of the test suite)
_test_chatterbox.py
test_porcupine.py
test_clone_output.wav

# Large voice-clone reference audio (kept locally, not committed — too big
# for plain git; if you need to share, use git-lfs or a separate channel)
assets/daddys_home.wav

# Debug audio dumps from voice_debug_save_audio (under repo for convenience
# during local debugging, never useful upstream)
debug_audio/

# .env files anywhere (Picovoice keys, OpenAI keys, etc.)
.env
**/.env

# Wake-word training scratch scripts, configs, and logs (one-off experiments
# from the custom "Hey Jarvis" training session — not part of the app or the
# test suite; regenerate from scripts/ as needed)
_oww_*.log
_clip_eval.py
_direct_eval.py
_fetch_rirs.py
_inject_real_positives.py
_recall_check.py
_split_wakeword.py
_hey_jarvis.yaml